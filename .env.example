# `npm run db:status` (supabase status) の出力からコピーしてください
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key（古い CLI では "anon key" と表示されます。どちらでも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 確認メールのリダイレクト先の基点（Origin ヘッダーが取れない場合のみ使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret key（旧 service_role key）。招待メールの送信に使う。サーバー専用・公開しないこと
SUPABASE_SECRET_KEY=
